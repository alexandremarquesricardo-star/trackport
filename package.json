{
  "name": "trackport",
  "version": "0.1.0",
  "private": true,
  "description": "Get your music from where it lives onto your offline device. Cross-platform sync tool for swim headphones, USB MP3 players, and similar offline audio devices.",
  "main": "./out/main/index.js",
  "author": "TrackPort",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/electron-vite.cjs dev",
    "build": "npm run typecheck && electron-vite build",
    "icons": "node scripts/build-icons.cjs",
    "start": "node scripts/electron-vite.cjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "drivelist": "^12.0.2"
  }
}
