# Copy to `.env.local` (gitignored) and fill in.
# Variables prefixed with VITE_ are baked into the build by electron-vite.

# Spotify Client ID — get from https://developer.spotify.com/dashboard
# → trackport-server (or whatever you named the app) → Settings.
# PKCE flow treats this as public; safe to share but pointless to commit.
VITE_SPOTIFY_CLIENT_ID=
